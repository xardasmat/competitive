{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Debug compile",
            "type": "shell",
            "command": "make",
            "args": [
                "debug/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            }
        },
        {
            "label": "Run test",
            "type": "shell",
            "command": "make",
            "args": [
                "test_${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
                }
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Run interactive test",
            "type": "shell",
            "command": "make",
            "args": [
                "testi_${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
                }
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}